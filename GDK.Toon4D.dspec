# DPM package spec file
min dpm client version: 1.0.0
metadata:
  id: GDK.Toon4D
  version: 1.0.1
  description: 'Delphi JSON to TOON encoder - 30-60% token reduction for LLM prompts.'
  authors:
    - GDK Software
  projectUrl: https://github.com/GDKsoftware/Toon4D
  repositoryUrl: https://github.com/GDKsoftware/Toon4D
  repositoryCommit: '#HASH#'
  license: MIT
  copyright: GDK Software
  tags:
    - json
    - toon
    - llm
    - encoder
  readme: README.md
variables:
  packagesource: RAD Studio $compilerNoPrefix$
targetPlatforms:
  - compiler from: delphi10.3
    compiler to: delphi13.0
    platforms:
      - win32
      - win64
      - linux64
templates:
  - name: default
    source:
      - src: ./Source/**.pas
      - src: ./packages/$packageSource$/*.dproj
      - src: ./packages/$packageSource$/*.dpk
    build:
      - project: ./packages/$packageSource$/Toon4D_R.dproj
